#!/usr/bin/env sh
# ==============================================================================
# git-clean: Remove Claude / Anthropic co-author trailers before pushing
# ==============================================================================
# Usage:
#   git-clean [OPTIONS] [PATH]
#
# Examples:
#   git-clean .             # Clean unpushed commits in current directory
#   git-clean -d .          # Dry-run preview without modifying history
#   git-clean -y .          # Clean unpushed commits without confirmation prompt
#   git-clean --all .       # Clean all commits on current branch
#   git-clean --exact .     # Match only exact "Claude Opus 5.5 noreply@anthropic.com"
# ==============================================================================

set -e

VERSION="1.0.0"

# ANSI color configuration (disabled if not a tty or NO_COLOR is set)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD="\033[1m"
  GREEN="\033[32m"
  CYAN="\033[36m"
  YELLOW="\033[33m"
  RED="\033[31m"
  RESET="\033[0m"
else
  BOLD=""
  GREEN=""
  CYAN=""
  YELLOW=""
  RED=""
  RESET=""
fi

print_help() {
  cat << EOF
${BOLD}git-clean v${VERSION}${RESET} - Clear Claude / Anthropic co-author tags before pushing

${BOLD}USAGE:${RESET}
    git-clean [OPTIONS] [PATH]

${BOLD}ARGUMENTS:${RESET}
    [PATH]                  Target git repository path (default: .)

${BOLD}OPTIONS:${RESET}
    -d, --dry-run           Preview affected commits without changing git history
    -y, --yes               Proceed with rewrite without interactive confirmation
    -a, --all               Clean all commits on current branch (default: unpushed only)
    -r, --range <RANGE>     Custom git commit range (e.g. HEAD~3..HEAD, origin/main..HEAD)
    --exact                 Match only exact "Claude Opus 5.5 noreply@anthropic.com"
    --install-hook          Install git pre-push safety guard in the current repo
    -h, --help              Show this help message
    -v, --version           Show version information

${BOLD}EXAMPLES:${RESET}
    git-clean .             Clean unpushed commits in the current directory
    git-clean -d .          Dry-run preview in the current directory
    git-clean -y .          Clean unpushed commits non-interactively
    git-clean --all .       Clean all commits on current branch from initial commit
EOF
}

# Default configuration
TARGET_DIR="."
DRY_RUN=0
ASSUME_YES=0
CLEAN_ALL=0
EXACT_MATCH=0
CUSTOM_RANGE=""
INSTALL_HOOK=0

# Parse CLI options
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    -v|--version)
      echo "git-clean version $VERSION"
      exit 0
      ;;
    -d|--dry-run)
      DRY_RUN=1
      shift
      ;;
    -y|--yes)
      ASSUME_YES=1
      shift
      ;;
    -a|--all)
      CLEAN_ALL=1
      shift
      ;;
    --exact)
      EXACT_MATCH=1
      shift
      ;;
    -r|--range)
      if [ -z "${2:-}" ]; then
        printf "${RED}Error: --range requires a git revision range (e.g. origin/main..HEAD)${RESET}\n" >&2
        exit 1
      fi
      CUSTOM_RANGE="$2"
      shift 2
      ;;
    --install-hook)
      INSTALL_HOOK=1
      shift
      ;;
    -*)
      printf "${RED}Error: Unknown option '$1'${RESET}\n\n" >&2
      print_help
      exit 1
      ;;
    *)
      TARGET_DIR="$1"
      shift
      ;;
  esac
done

# Navigate to target directory
cd "$TARGET_DIR" 2>/dev/null || {
  printf "${RED}Error: Directory '%s' does not exist.${RESET}\n" "$TARGET_DIR" >&2
  exit 1
}

# Verify git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  printf "${RED}Error: '%s' is not a git repository.${RESET}\n" "$(pwd)" >&2
  exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Install pre-push guard hook if requested
if [ "$INSTALL_HOOK" -eq 1 ]; then
  HOOK_PATH="$REPO_ROOT/.git/hooks/pre-push"
  mkdir -p "$REPO_ROOT/.git/hooks"
  cat << 'HOOK_EOF' > "$HOOK_PATH"
#!/usr/bin/env sh
# Git pre-push hook generated by git-clean
# Prevents pushing commits containing Claude co-author trailers

if command -v git-clean >/dev/null 2>&1; then
  git-clean --dry-run . >/dev/null 2>&1 || {
    echo ""
    echo "================================================================"
    echo "  [ABORTED] Uncleaned Claude co-authors detected before push!"
    echo "  Run 'git-clean .' to strip co-author tags before pushing."
    echo "================================================================"
    echo ""
    exit 1
  }
fi
exit 0
HOOK_EOF
  chmod +x "$HOOK_PATH" 2>/dev/null || true
  printf "${GREEN}${BOLD}✓ Pre-push hook installed at %s${RESET}\n" "$HOOK_PATH"
  exit 0
fi

# Configure regex patterns
if [ "$EXACT_MATCH" -eq 1 ]; then
  FILTER_PATTERN="^[[:space:]]*[Cc][Oo]-[Aa][Uu][Tt][Hh][Oo][Rr][Ee][Dd]-[Bb][Yy]:[[:space:]]*Claude Opus 5\.5 noreply@anthropic\.com"
  GREP_PATTERN="Co-Authored-By:[[:space:]]*Claude Opus 5\.5 noreply@anthropic\.com"
else
  FILTER_PATTERN="^[[:space:]]*[Cc][Oo]-[Aa][Uu][Tt][Hh][Oo][Rr][Ee][Dd]-[Bb][Yy]:.*([Cc]laude|anthropic\.com)"
  GREP_PATTERN="Co-Authored-By:.*([Cc]laude|anthropic\.com)"
fi

# Check branch state
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ -z "$CURRENT_BRANCH" ] || [ "$CURRENT_BRANCH" = "HEAD" ]; then
  printf "${RED}Error: HEAD is in a detached state. Please checkout a branch first.${RESET}\n" >&2
  exit 1
fi

# Determine commit range
if [ -n "$CUSTOM_RANGE" ]; then
  COMMIT_RANGE="$CUSTOM_RANGE"
  RANGE_DESC="custom range ($CUSTOM_RANGE)"
elif [ "$CLEAN_ALL" -eq 1 ]; then
  COMMIT_RANGE="HEAD"
  RANGE_DESC="all commits on branch '$CURRENT_BRANCH'"
else
  # Default: Detect unpushed commits
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
  if [ -n "$UPSTREAM" ]; then
    COMMIT_RANGE="$UPSTREAM..HEAD"
    RANGE_DESC="unpushed commits against upstream ($UPSTREAM)"
  else
    # Upstream not set; check if origin has this branch
    if git rev-parse --verify "origin/$CURRENT_BRANCH" >/dev/null 2>&1; then
      COMMIT_RANGE="origin/$CURRENT_BRANCH..HEAD"
      RANGE_DESC="unpushed commits against origin/$CURRENT_BRANCH"
    else
      # Check divergence from origin default branch
      REMOTE_HEAD=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || true)
      BASE_FOUND=""
      for candidate in "$REMOTE_HEAD" origin/main origin/master origin/develop; do
        if [ -n "$candidate" ] && git rev-parse --verify "$candidate" >/dev/null 2>&1; then
          BASE=$(git merge-base HEAD "$candidate" 2>/dev/null || true)
          if [ -n "$BASE" ]; then
            COMMIT_RANGE="$BASE..HEAD"
            RANGE_DESC="unpushed commits from divergence with $candidate"
            BASE_FOUND=1
            break
          fi
        fi
      done
      if [ -z "$BASE_FOUND" ]; then
        # Purely local branch / no remotes found
        COMMIT_RANGE="HEAD"
        RANGE_DESC="all local commits on '$CURRENT_BRANCH' (no remote tracking found)"
      fi
    fi
  fi
fi

printf "${BOLD}Repository:${RESET} %s\n" "$REPO_ROOT"
printf "${BOLD}Branch:${RESET}     %s\n" "$CURRENT_BRANCH"
printf "${BOLD}Scope:${RESET}      %s\n\n" "$RANGE_DESC"

# Search for matching commits in range
MATCHING_COMMITS=$(git log "$COMMIT_RANGE" -E -i --grep="$GREP_PATTERN" --format="%H" 2>/dev/null || true)

if [ -z "$MATCHING_COMMITS" ]; then
  printf "${GREEN}${BOLD}✓ No Claude co-authored commits found in %s.${RESET}\n" "$RANGE_DESC"
  printf "Everything is clean and ready to push!\n"
  exit 0
fi

# Count matches
MATCH_COUNT=$(printf "%s\n" "$MATCHING_COMMITS" | grep -c . || echo "0")

printf "${YELLOW}${BOLD}Found %d commit(s) with Claude co-author trailer:${RESET}\n" "$MATCH_COUNT"
for sha in $MATCHING_COMMITS; do
  SHORT_SHA=$(git rev-parse --short "$sha")
  SUBJECT=$(git log -1 --format="%s" "$sha")
  COAUTHORS=$(git log -1 --format="%B" "$sha" | grep -E -i "$GREP_PATTERN" | tr '\r' ' ' || true)
  printf "  ${CYAN}%s${RESET} %s\n" "$SHORT_SHA" "$SUBJECT"
  printf "    ${RED}- %s${RESET}\n" "$COAUTHORS"
done
printf "\n"

# Dry run mode check
if [ "$DRY_RUN" -eq 1 ]; then
  printf "${CYAN}${BOLD}[Dry-run mode]${RESET} %d commit(s) would be cleaned. No changes made.\n" "$MATCH_COUNT"
  exit 0
fi

# Ensure working directory is clean
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
  printf "${RED}${BOLD}Error:${RESET} Working directory has uncommitted or staged changes.\n" >&2
  printf "Please commit or stash changes before rewriting git history:\n" >&2
  printf "    git stash\n" >&2
  printf "    git-clean .\n" >&2
  printf "    git stash pop\n" >&2
  exit 1
fi

# Confirmation prompt unless -y / --yes
if [ "$ASSUME_YES" -ne 1 ]; then
  printf "${BOLD}Strip Claude co-author trailer and lines below from these %d commit(s)? [y/N]: ${RESET}" "$MATCH_COUNT"
  read -r CONFIRM
  case "$CONFIRM" in
    [yY]|[yY][eE][sS])
      ;;
    *)
      printf "Aborted. No changes made.\n"
      exit 0
      ;;
  esac
fi

printf "\n${BOLD}Cleaning commit history...${RESET}\n"

# Create a temporary filter script with LF line endings
TMP_FILTER=$(mktemp)
trap 'rm -f "$TMP_FILTER"' EXIT INT TERM

cat << EOF > "$TMP_FILTER"
awk '
BEGIN { count = 0 }
{
  sub(/\r$/, "", \$0)
  line = \$0
  if (line ~ /$FILTER_PATTERN/) {
    exit
  }
  count++
  lines[count] = line
}
END {
  while (count > 0 && lines[count] ~ /^[[:space:]]*\$/) {
    count--
  }
  for (i = 1; i <= count; i++) {
    print lines[i]
  }
}
'
EOF

# Execute git filter-branch on target range
export FILTER_BRANCH_SQUELCH_WARNING=1
git filter-branch -f --msg-filter "sh '$TMP_FILTER'" "$COMMIT_RANGE" >/dev/null

# Clean up any backup refs left by filter-branch
git for-each-ref --format="%(refname)" refs/original/ | while read -r ref; do
  git update-ref -d "$ref" 2>/dev/null || true
done

printf "\n${GREEN}${BOLD}✓ Successfully cleaned %d commit(s)!${RESET}\n\n" "$MATCH_COUNT"
printf "${BOLD}Updated log preview:${RESET}\n"
git log -n "$MATCH_COUNT" --format="  ${CYAN}%h${RESET} %s"
printf "\n${BOLD}Ready to push:${RESET} git push origin %s\n" "$CURRENT_BRANCH"
